{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  // Task-only docs edges and shared helper inputs must participate in selection.
  // Recheck affected plans using CONTRIBUTING.md#ci when upgrading Turbo.
  "futureFlags": { "affectedUsingTaskInputs": true },
  // Root configuration is deliberately conservative: select and invalidate every task.
  "globalDependencies": [
    "**/.env.*local",
    "package.json",
    "pnpm-workspace.yaml",
    "tsconfig.json",
    "scripts/tsconfig.json"
  ],
  // Archive prefixes do not participate in remote task hashes. pnpm's user agent
  // supplies exact Node/platform/architecture; runner image and env also matter.
  "globalEnv": [
    "CI",
    "ImageOS",
    "ImageVersion",
    "LANG",
    "LC_ALL",
    "NODE_ENV",
    "NODE_OPTIONS",
    "RUNNER_ARCH",
    "RUNNER_OS",
    "TZ",
    "npm_config_user_agent"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/getTsdownConfig.ts",
        "$TURBO_ROOT$/scripts/buildPackageDocs.ts",
        "$TURBO_ROOT$/scripts/docsUtils.ts"
      ],
      "outputLogs": "new-only",
      "outputs": ["!.next/cache/**", "!.next/dev/**", ".next/**", "dist/**"]
    },
    "build:docs": {
      "dependsOn": ["^build:docs"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/buildPackageDocs.ts",
        "$TURBO_ROOT$/scripts/docsUtils.ts"
      ],
      "outputs": ["dist/docs/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "docs#build": {
      "dependsOn": [
        "@noaignite/centra-mocks#build",
        "@noaignite/centra-types#build",
        "@noaignite/create-app#build",
        "@noaignite/react-centra-checkout#build",
        "@noaignite/react-native-eslint#build",
        "@noaignite/react-utils#build",
        "@noaignite/style-guide#build",
        "@noaignite/tailwind-typography#build",
        "@noaignite/types#build",
        "@noaignite/utils#build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/CONTRIBUTING.md",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/scripts/assembleDocsContent.ts",
        "$TURBO_ROOT$/scripts/findPackagesWithDocs.ts",
        "$TURBO_ROOT$/scripts/docsUtils.ts"
      ],
      "outputLogs": "new-only",
      "outputs": [
        "!.next/cache/**",
        "!.next/dev/**",
        ".next/**",
        "next-env.d.ts",
        "public/_pagefind/**",
        "src/content/**"
      ]
    },
    "docs#dev": {
      "cache": false,
      "dependsOn": [
        "@noaignite/centra-mocks#build:docs",
        "@noaignite/centra-types#build:docs",
        "@noaignite/create-app#build:docs",
        "@noaignite/react-centra-checkout#build:docs",
        "@noaignite/react-native-eslint#build:docs",
        "@noaignite/react-utils#build:docs",
        "@noaignite/style-guide#build:docs",
        "@noaignite/tailwind-typography#build:docs",
        "@noaignite/types#build:docs",
        "@noaignite/utils#build:docs"
      ],
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build", "^lint"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/getTsdownConfig.ts",
        "$TURBO_ROOT$/scripts/getVitestConfig.ts"
      ]
    },
    "docs#lint": {
      "dependsOn": ["^build", "^lint", "build"]
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "test:coverage": {
      "dependsOn": ["^build", "^test:coverage"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/getVitestConfig.ts"],
      "outputs": ["coverage/**"]
    },
    "test:package": {
      "cache": false,
      "dependsOn": ["^build", "build"]
    },
    "test:types": {
      "dependsOn": ["^build", "^test:types"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/getTsdownConfig.ts",
        "$TURBO_ROOT$/scripts/getVitestConfig.ts"
      ]
    },
    "docs#test:types": {
      "dependsOn": ["^build", "^test:types", "build"]
    },
    "test:unit": {
      "dependsOn": ["^build", "^test:unit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/getVitestConfig.ts"]
    },
    "test:unit:watch": {
      "dependsOn": ["^test:unit:watch"]
    }
  }
}
