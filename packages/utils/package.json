{
  "name": "@noaignite/utils",
  "version": "4.0.0",
  "private": false,
  "description": "Utility functions used by NoA Ignite",
  "keywords": [
    "utils"
  ],
  "bugs": {
    "url": "https://github.com/noaignite/accelerator/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/noaignite/accelerator.git",
    "directory": "packages/utils"
  },
  "license": "MIT",
  "author": "NoA Ignite",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./assert": "./dist/assert.js",
    "./calculateContrast": "./dist/calculateContrast.js",
    "./calculateLuminance": "./dist/calculateLuminance.js",
    "./capitalize": "./dist/capitalize.js",
    "./chunk": "./dist/chunk.js",
    "./clamp": "./dist/clamp.js",
    "./colorContrast": "./dist/colorContrast.js",
    "./createBatchedCallback": "./dist/createBatchedCallback.js",
    "./debounce": "./dist/debounce.js",
    "./deepmerge": "./dist/deepmerge.js",
    "./hexToRGB": "./dist/hexToRGB.js",
    "./isKeyOf": "./dist/isKeyOf.js",
    "./isObject": "./dist/isObject.js",
    "./isPlainObject": "./dist/isPlainObject.js",
    "./lerp": "./dist/lerp.js",
    "./mapRange": "./dist/mapRange.js",
    "./normalize": "./dist/normalize.js",
    "./normalizeToArray": "./dist/normalizeToArray.js",
    "./objectFromURLSearchParams": "./dist/objectFromURLSearchParams.js",
    "./omit": "./dist/omit.js",
    "./pick": "./dist/pick.js",
    "./random": "./dist/random.js",
    "./range": "./dist/range.js",
    "./round": "./dist/round.js",
    "./sleep": "./dist/sleep.js",
    "./toggleArrayValue": "./dist/toggleArrayValue.js",
    "./toRootRelativePath": "./dist/toRootRelativePath.js",
    "./traverse": "./dist/traverse.js",
    "./URLSearchParamsFromObject": "./dist/URLSearchParamsFromObject.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown --config-loader unrun && pnpm build:docs",
    "build:docs": "node ../../scripts/buildPackageDocs.ts",
    "lint": "eslint .",
    "test:coverage": "vitest run --coverage",
    "test:package": "publint --pack pnpm --strict && attw --pack . --profile esm-only",
    "test:types": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest"
  },
  "dependencies": {
    "@noaignite/types": "workspace:*"
  },
  "devDependencies": {
    "@noaignite/style-guide": "workspace:*"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
