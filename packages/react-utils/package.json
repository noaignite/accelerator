{
  "name": "@noaignite/react-utils",
  "version": "1.0.1",
  "private": false,
  "description": "React utils",
  "keywords": [
    "react",
    "react-utils",
    "tanstack-intent",
    "typescript"
  ],
  "bugs": {
    "url": "https://github.com/noaignite/accelerator/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/noaignite/accelerator.git",
    "directory": "packages/react-utils"
  },
  "license": "MIT",
  "author": "NoA Ignite",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./createPolymorph": "./dist/createPolymorph.js",
    "./createRenderBlock": "./dist/createRenderBlock.js",
    "./createRequiredContext": "./dist/createRequiredContext.js",
