  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsdown --config-loader unrun && pnpm build:docs",
    "build:docs": "node ../../scripts/buildPackageDocs.ts",
    "dev": "tsdown --config-loader unrun --watch",
    "intent:stale": "pnpm dlx @tanstack/intent@latest stale skills",
    "intent:validate": "pnpm dlx @tanstack/intent@latest validate skills",
    "lint": "eslint .",
    "test:coverage": "vitest run --coverage",
    "test:package": "publint --pack pnpm --strict && attw --pack . --profile esm-only",
    "test:types": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest"
  },
  "dependencies": {
    "@noaignite/types": "workspace:*",
    "@noaignite/utils": "workspace:*"
  },
  "devDependencies": {
    "@noaignite/style-guide": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "react": "^19.3.1"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
