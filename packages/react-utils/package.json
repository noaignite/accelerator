    "./isReactElement": "./dist/isReactElement.js",
    "./isReactFragment": "./dist/isReactFragment.js",
    "./isRefObject": "./dist/isRefObject.js",
    "./setRef": "./dist/setRef.js",
    "./useControlled": "./dist/useControlled.js",
    "./useDismiss": "./dist/useDismiss.js",
    "./useDragScroll": "./dist/useDragScroll.js",
    "./useEffect.component": "./dist/useEffect.component.js",
    "./useElementSize": "./dist/useElementSize.js",
    "./useEvent": "./dist/useEvent.js",
    "./useFocusReturn": "./dist/useFocusReturn.js",
    "./useForkRef": "./dist/useForkRef.js",
    "./useGesture": "./dist/useGesture.js",
    "./useId.component": "./dist/useId.component.js",
    "./useInert": "./dist/useInert.js",
    "./useIntersectionObserver": "./dist/useIntersectionObserver.js",
    "./useInterval": "./dist/useInterval.js",
    "./useIsomorphicEffect": "./dist/useIsomorphicEffect.js",
    "./useMediaQuery": "./dist/useMediaQuery.js",
    "./useMutationObserver": "./dist/useMutationObserver.js",
    "./usePressHold": "./dist/usePressHold.js",
    "./useRef.component": "./dist/useRef.component.js",
    "./useRefObject": "./dist/useRefObject.js",
    "./useResizeObserver": "./dist/useResizeObserver.js",
    "./useRTL": "./dist/useRTL.js",
    "./useRTL.component": "./dist/useRTL.component.js",
    "./useScrollProgress": "./dist/useScrollProgress.js",
    "./useStableCallback": "./dist/useStableCallback.js",
    "./useState.component": "./dist/useState.component.js",
    "./useSticky": "./dist/useSticky.js",
    "./useTimeout": "./dist/useTimeout.js",
    "./useVisualViewport": "./dist/useVisualViewport.js",
    "./useWindowSize": "./dist/useWindowSize.js"
