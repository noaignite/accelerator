{
  "name": "@noaignite/react-native-eslint",
  "version": "1.2.5",
  "description": "A comprehensive ESLint configuration for React Native projects with TypeScript support",
  "keywords": [
    "config",
    "eslint",
    "javascript",
    "linting",
    "react-native",
    "typescript"
  ],
  "bugs": {
    "url": "https://github.com/noaignite/accelerator/issues"
  },
  "license": "MIT",
  "author": "NoA Ignite",
  "repository": {
    "type": "git",
    "url": "https://github.com/noaignite/accelerator.git",
    "directory": "packages/react-native-eslint"
  },
  "files": [
    "dist",
    "eslint.config.js"
  ],
  "type": "module",
  "main": "eslint.config.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm build:docs",
    "build:docs": "node ../../scripts/buildPackageDocs.ts"
  },
  "dependencies": {
    "@eslint/compat": "1.4.1",
    "@stylistic/eslint-plugin": "4.4.1",
    "eslint-plugin-jest": "28.14.0",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-react-native": "5.0.0",
    "typescript-eslint": "8.73.0"
  },
  "devDependencies": {
    "eslint": "^9.39.4",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0",
    "typescript": ">=4.8.4 <6.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
