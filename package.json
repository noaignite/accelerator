{
  "name": "accelerator",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "ci:release": "pnpm build && pnpm test && changeset publish",
    "ci:status": "changeset status --since=origin/main",
    "ci:test": "pnpm lint && pnpm test:types && pnpm test:coverage && pnpm test:package",
    "clean": "node ./scripts/clean.ts",
    "dev": "turbo dev",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "turbo lint",
    "packages:build": "turbo build --filter=@noaignite/*",
    "packages:build-docs": "turbo build:docs --filter=@noaignite/*",
    "pre-commit": "lint-staged",
    "prepare": "node .husky/install.mjs",
    "release:verdaccio": "pnpm build && pnpm test && pnpm publish --no-git-checks --recursive --registry=\"http://localhost:4873/\"",
    "start": "turbo start",
    "test": "pnpm lint && pnpm test:types && pnpm test:unit && pnpm test:package",
    "test:coverage": "turbo test:coverage",
    "test:package": "turbo test:package --filter=@noaignite/*",
    "test:types": "turbo test:types",
    "test:unit": "turbo test:unit",
    "test:unit:watch": "turbo watch test:unit:watch"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^2.31.1",
    "@noaignite/style-guide": "workspace:*",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.0.5",
    "oxfmt": "^0.79.0",
    "publint": "^0.3.25",
    "ts-morph": "^28.0.0",
    "tsdown": "^0.23.7",
    "turbo": "^2.11.13",
    "typescript": "^6.0.3",
    "unrun": "^0.3.1",
    "vitest": "^5.1.1"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0",
    "pnpm": "^12"
  },
  "packageManager": "pnpm@12.21.0"
}
