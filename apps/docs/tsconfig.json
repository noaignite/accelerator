{
  "extends": "@noaignite/style-guide/typescript/next",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "next-env.d.ts", ".next/types/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
